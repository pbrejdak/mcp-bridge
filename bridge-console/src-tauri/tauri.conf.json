{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Bridge Console",
  "version": "0.1.0",
  "identifier": "dev.mcpbridge.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "console",
        "title": "MCP Bridge",
        "width": 900,
        "height": 600,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["mcp-bridge"]
      }
    }
  }
}
